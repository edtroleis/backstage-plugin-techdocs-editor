{
  "name": "backstage-plugin-techdocs-editor",
  "version": "1.0.0",
  "private": true,
  "engines": {
    "node": "22 || 24"
  },
  "scripts": {
    "start": "node scripts/prepare-dev-wiki.mjs && backstage-cli repo start",
    "build:all": "backstage-cli repo build --all",
    "knip:editor": "knip --workspace plugins/techdocs-editor --workspace plugins/techdocs-editor-common --workspace plugins/scaffolder-backend-module-techdocs-editor",
    "tsc": "tsc",
    "tsc:full": "tsc --skipLibCheck false --incremental false",
    "clean": "backstage-cli repo clean",
    "test": "backstage-cli repo test",
    "test:all": "backstage-cli repo test --coverage",
    "test:editor": "yarn test:editor:unit && yarn test:editor:browser",
    "test:editor:unit": "CI=1 yarn workspaces foreach -A --include '@edtroleis/*' run test --watchAll=false",
    "test:editor:browser": "playwright test -c plugins/techdocs-editor/e2e/playwright.config.ts",
    "test:editor:portal": "playwright test -c plugins/techdocs-editor/e2e/portal/playwright.config.ts",
    "fix": "backstage-cli repo fix",
    "lint": "backstage-cli repo lint --since origin/main",
    "lint:all": "backstage-cli repo lint",
    "prettier:check": "prettier --check .",
    "changeset": "changeset",
    "release": "node scripts/publish.mjs",
    "release:version": "changeset version && yarn install --mode=update-lockfile"
  },
  "backstage": {
    "cli": {
      "new": {
        "globals": {
          "license": "Apache-2.0"
        }
      }
    }
  },
  "workspaces": [
    "packages/*",
    "plugins/*"
  ],
  "devDependencies": {
    "@backstage/cli": "^0.36.7",
    "@backstage/cli-defaults": "^0.1.7",
    "@changesets/cli": "2.31.1",
    "@jest/environment-jsdom-abstract": "^30.5.0",
    "@playwright/test": "^1.32.3",
    "@types/jest": "^30.0.0",
    "jest": "^30.5.0",
    "jsdom": "^30.1.3",
    "knip": "6.40.0",
    "node-gyp": "^12.4.0",
    "prettier": "^2.3.2",
    "typescript": "~5.8.0"
  },
  "resolutions": {
    "@yarnpkg/core": "4.9.1",
    "@types/react": "^18",
    "@types/react-dom": "^18",
    "adm-zip@npm:0.6.0": "npm:0.6.1",
    "undici@npm:7.29.0": "npm:7.30.1"
  },
  "prettier": "@backstage/cli/config/prettier",
  "lint-staged": {
    "*.{js,jsx,ts,tsx,mjs,cjs}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md}": [
      "prettier --write"
    ]
  },
  "packageManager": "yarn@4.13.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/edtroleis/backstage-plugin-techdocs-editor.git"
  }
}
