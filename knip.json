{
  "$schema": "https://unpkg.com/knip@6.40.0/schema.json",
  "workspaces": {
    "plugins/techdocs-editor": {
      "entry": [
        "e2e/**/*.{ts,tsx}"
      ],
      "project": [
        "src/**/*.{ts,tsx}",
        "e2e/**/*.{ts,tsx}"
      ]
    },
    "plugins/techdocs-editor-common": {
      "entry": [
        "scripts/*.mjs"
      ],
      "project": [
        "src/**/*.ts",
        "scripts/*.mjs"
      ],
      "ignore": [
        "src/vendor/**"
      ]
    },
    "plugins/scaffolder-backend-module-techdocs-editor": {
      "project": [
        "src/**/*.ts"
      ]
    }
  }
}
